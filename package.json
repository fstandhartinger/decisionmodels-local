{
  "name": "decisionmodels-local-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/suggest-hardware.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "suggest:hardware": "node scripts/suggest-hardware.mjs",
    "export:hub-cards": "node scripts/export-hub-cards.mjs"
  },
  "dependencies": {
    "next": "15.5.27",
    "nodemailer": "10.0.16",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "6.4.21",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.22",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
