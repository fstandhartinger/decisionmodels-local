        "support_files": [
          {
            "path": "mammoth_server.py",
            "content": "\"\"\"Text-only HTTP wrapper over Mammoth's documented patched DecisionEngine.\"\"\"\nimport argparse\nimport uvicorn\nfrom qev.engine import DecisionEngine\nfrom qev.server import create_app\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--model\", required=True)\nparser.add_argument(\"--host\", choices=[\"127.0.0.1\"], default=\"127.0.0.1\")\nparser.add_argument(\"--port\", type=int, required=True)\nargs = parser.parse_args()\nengine = DecisionEngine(args.model, device=\"cuda:0\", max_branch_tokens=16384,\n                        max_request_tokens=16384)\nprint(\"Mammoth readout:\", engine.info.extra, \"fork_mode:\", engine.info.fork_mode, flush=True)\nuvicorn.run(create_app(engine, model_name=\"baselabs/mammoth-1\"), host=args.host, port=args.port)\n",
