# Postgres connection used for licence records, Stripe event idempotency, and hardware inquiries.
DATABASE_URL=postgresql://user:password@localhost:5432/decisionmodels_local

# At least 32 characters; used to encrypt short-lived licence/email delivery payloads.
LICENCE_DELIVERY_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Stripe secrets and existing Price IDs. No Stripe objects are created by this repository.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SETUP=
STRIPE_PRICE_MONTHLY=

# SMTP; when unset, inquiries and encrypted mail remain queued in Postgres.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=info@decisionmodels.io

# Optional override; defaults to the latest GitHub release download directory.
INSTALLER_RELEASE_BASE=
